{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "acceptora/verification-laravel",
    "description": "Laravel 12 and 13 client for Acceptora verification over REST and MCP.",
    "type": "library",
    "keywords": [
        "acceptora",
        "api",
        "ai-agents",
        "human verification",
        "laravel",
        "mcp",
        "openapi",
        "php",
        "verification",
        "rest"
    ],
    "homepage": "https://www.acceptora.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Acceptora",
            "homepage": "https://www.acceptora.com"
        }
    ],
    "support": {
        "docs": "https://www.acceptora.com/docs",
        "issues": "https://github.com/Elvesora/acceptora-laravel/issues",
        "source": "https://github.com/Elvesora/acceptora-laravel"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9 || ^8.0",
        "illuminate/support": "^12.0 || ^13.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.50 || ^12.5.8"
    },
    "autoload": {
        "psr-4": {
            "Acceptora\\Verification\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Acceptora\\Verification\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "format": "pint",
        "format-test": "pint --test",
        "validate-package": "@composer validate --strict",
        "security-audit": "@composer audit --locked --no-interaction",
        "check": [
            "@validate-package",
            "@format-test",
            "@test",
            "@analyse",
            "@security-audit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Acceptora\\Verification\\Laravel\\VerificationServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/.github",
            "/.git",
            "/.phpstan.cache",
            "/.phpunit.cache",
            "/build",
            "/tests",
            "/vendor",
            "/composer.lock",
            "/phpunit.xml.dist",
            "/phpstan.neon.dist",
            "/pint.json"
        ]
    }
}
